include=~/.config/mako/colors

font=JetBrainsMono Nerd Font 11
anchor=top-right
margin=8
padding=12
width=360
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=5000
max-history=50

[urgency=critical]
default-timeout=0

[mode=do-not-disturb]
invisible=1

# Volume/brightness popups (hypr/scripts/osd.sh); colors in the generated colors file
[app-name=osd]
anchor=top-center
width=280
padding=10
max-icon-size=32
default-timeout=1500
history=0
format=<b>%s</b>  %b

# Feedback for your own key presses: keep showing during do-not-disturb
[mode=do-not-disturb app-name=osd]
invisible=0
