/*
 * Wi-Fi share popup (hypr/scripts/wifi.sh): QR code on the left, network and password on the
 * right. The QR image is set per call with -theme-str.
 */
@import "config.rasi"

/* Fixed height so the QR box stays square (240 + 2 × 16 padding); a taller box tiles the image */
window {
    width:                       560px;
    height:                      272px;
    border-radius:               20px;
}
mainbox {
    orientation:                 horizontal;
    padding:                     16px;
    spacing:                     20px;
    children:                    [ "imagebox", "message" ];
}
imagebox {
    expand:                      false;
    width:                       240px;
    border-radius:               14px;
    background-color:            white;
}
message {
    expand:                      true;
    background-color:            transparent;
}
textbox {
    padding:                     4px 2px;
    background-color:            transparent;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
