{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,

  "modules-left": ["custom/hub", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/recording",
    "custom/dnd",
    "custom/awake",
    "tray",
    "custom/nightlight",
    "pulseaudio",
    "backlight",
    "network",
    "bluetooth",
    "power-profiles-daemon",
    "battery",
    "custom/power"
  ],

  // Desktop d = workspace d on the external screen, 10+d on the laptop
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "11": "1", "12": "2", "13": "3", "14": "4" },
    "persistent-workspaces": {
      "eDP-1": [11, 12, 13, 14],
      "*": [1, 2, 3, 4]
    }
  },

  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/hub": {
    "format": "󰣇",
    "tooltip-format": "Settings (Super+A)",
    "on-click": "~/.config/hypr/scripts/hub.sh",
    "on-click-right": "~/.config/hypr/scripts/hub.sh keys"
  },

  "custom/dnd": {
    "exec": "makoctl mode | grep -q do-not-disturb && echo '󰂛' || echo ''",
    "interval": "once",
    "signal": 12,
    "tooltip-format": "Do not disturb",
    "on-click": "makoctl mode -t do-not-disturb >/dev/null; pkill -RTMIN+12 waybar"
  },

  "custom/awake": {
    "exec": "pgrep -x hypridle >/dev/null && echo '' || echo '󰅶'",
    "interval": "once",
    "signal": 11,
    "tooltip-format": "Keep awake: idle/lock paused",
    "on-click": "setsid -f hypridle >/dev/null 2>&1; sleep 0.2; pkill -RTMIN+11 waybar"
  },

  "custom/recording": {
    "exec": "pgrep -x wf-recorder >/dev/null && echo '󰑊 REC' || echo ''",
    "interval": "once",
    "signal": 9,
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/record.sh"
  },

  "custom/nightlight": {
    "exec": "pgrep -x hyprsunset >/dev/null && echo '󰖔' || echo '󰖙'",
    "interval": "once",
    "signal": 8,
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/nightlight.sh"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤭 offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "on-click": "kitty --class nmtui -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "tooltip-format": "{timeTo}, {power:.1f}W"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  }
}
