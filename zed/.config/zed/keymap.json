// Zed keymap
//
// For information on how to configure Zed's keymap, see the Zed
// documentation: https://zed.dev/docs/key-bindings
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space": null
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space g g": ["task::Spawn", { "task_name": "lazygit" }],
      "space u": "workspace::SaveWithoutFormat",
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f b": "tab_switcher::Toggle",
      "space f t": "workspace::NewTerminal",
      "space s g": "pane::DeploySearch",
      "space /": "pane::DeploySearch",
      "space e": "project_panel::ToggleFocus",
      "space x x": "diagnostics::Deploy",
      "space c f": "editor::Format",
      "space q q": "zed::Quit",
      "space b d": ["pane::CloseActiveItem", { "close_pinned": false }]
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore"
    }
  }
]
