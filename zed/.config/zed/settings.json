// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    "background": "#1d2021f0"
  },
  "tab_size": 2,
  "relative_line_numbers": true,
  "vertical_scroll_margin": 8,
  "horizontal_scroll_margin": 8,
  "format_on_save": "on",
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "languages": {
    "Python": {
      "tab_size": 4,
      "formatter": [
        { "external": { "command": "/home/mmi/.local/share/nvim/mason/bin/black", "arguments": ["-q", "-"] } },
        { "external": { "command": "/home/mmi/.local/share/nvim/mason/bin/isort", "arguments": ["-"] } }
      ]
    },
    "Lua": {
      "formatter": { "external": { "command": "/home/mmi/.local/share/nvim/mason/bin/stylua", "arguments": ["-"] } }
    },
    "Shell Script": {
      "formatter": { "external": { "command": "/home/mmi/.local/share/nvim/mason/bin/shfmt", "arguments": [] } }
    }
  },
}
